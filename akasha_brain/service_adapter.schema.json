{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Akasha HTTPS JSON adapter registry v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 128,
  "items": {
    "type": "object",
    "required": [
      "id",
      "version",
      "adapter",
      "origin",
      "authentication",
      "operations"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
      },
      "version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])",
        "maxLength": 32
      },
      "adapter": {
        "const": "service-https-json.v1"
      },
      "origin": {
        "type": "string",
        "maxLength": 300
      },
      "authentication": {
        "enum": [
          "none",
          "api_key"
        ]
      },
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "required": [
            "id",
            "path",
            "method",
            "effect",
            "purpose",
            "input_schema",
            "output_schema"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^/(?:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*)?(?![\\s\\S])"
            },
            "method": {
              "enum": [
                "GET",
                "PUT",
                "POST",
                "PATCH"
              ]
            },
            "effect": {
              "enum": [
                "read",
                "persistent"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "input_schema": {
              "$ref": "#/$defs/record"
            },
            "output_schema": {
              "$ref": "#/$defs/record"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "boolean",
                  "integer",
                  "string",
                  "number"
                ]
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8192
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ],
                  "maxLength": 256
                }
              },
              "pattern": {
                "const": "^[a-z][a-z0-9-]*(?![\\s\\S])"
              }
            },
            "additionalProperties": false
          }
        },
        "required": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  }
}
