{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akasha://schemas/RetentionCopy/1.0.0",
  "title": "RetentionCopy",
  "type": "object",
  "required": ["version", "copy_id", "source_ids", "project", "category", "retention_class", "location", "created_at", "expires_at"],
  "properties": {
    "version": {"const": "1.0.0"},
    "copy_id": {"type": "string", "format": "uuid"},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "project": {"type": ["string", "null"], "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "retention_class": {"enum": ["temporary", "minimized_result", "real_content", "capture", "synthetic"]},
    "location": {"enum": ["working", "managed", "backup"]},
    "created_at": {"type": "string", "format": "akasha-utc"},
    "expires_at": {"type": ["string", "null"], "format": "akasha-utc"},
    "backup_id": {"type": "string", "format": "uuid"},
    "backup_consent_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"location": {"const": "backup"}}},
      "then": {"required": ["backup_id"], "properties": {"expires_at": {"type": "string"}}}
    },
    {
      "if": {
        "properties": {
          "location": {"const": "backup"},
          "retention_class": {"enum": ["real_content", "capture"]}
        }
      },
      "then": {"required": ["backup_consent_ids"], "properties": {"project": {"type": "string"}}}
    },
    {
      "if": {"properties": {"retention_class": {"enum": ["minimized_result", "real_content", "capture"]}}},
      "then": {"properties": {"expires_at": {"type": "string"}}}
    }
  ],
  "additionalProperties": false
}
