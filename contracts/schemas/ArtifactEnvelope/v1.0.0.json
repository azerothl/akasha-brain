{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akasha://schemas/ArtifactEnvelope/1.0.0",
  "title": "ArtifactEnvelope",
  "description": "Enveloppe d'artefact avec provenance PROV/SLSA, spec §6 et §6.1. Gel v0.",
  "type": "object",
  "required": ["schema_ref", "schema_version", "content_digest", "producer", "status", "created_at"],
  "properties": {
    "schema_ref": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "content_digest": {
      "type": "string",
      "description": "Digest SHA-256 du contenu, aussi adresse de stockage.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "required": ["capability_id", "version"],
      "properties": {
        "capability_id": {"type": "string"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    },
    "inputs_digests": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "status": {"enum": ["proposal", "observation", "verified", "correction"]},
    "confidentiality": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
