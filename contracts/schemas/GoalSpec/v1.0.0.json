{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akasha://schemas/GoalSpec/1.0.0",
  "title": "GoalSpec",
  "description": "Objectif structuré, spec §5.2. Gel v0.",
  "type": "object",
  "required": ["goal_id", "user_intent", "success_conditions", "risk_class"],
  "properties": {
    "goal_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "user_intent": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "constraints": {
      "type": "object",
      "properties": {
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "environment_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "success_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "akasha://schemas/SuccessPredicate/1.0.0"}
    },
    "risk_class": {"enum": ["R0", "R1", "R2", "R3"]},
    "resource_budget": {"type": "object"},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "approval_requirements": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
